{
  "name": "@neohomepage/app",
  "version": "0.1.0",
  "description": "Self-hosted, UI-editable homepage dashboard",
  "license": "MIT",
  "type": "module",
  "bin": {
    "neo": "./src/cli/neo.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch --watch-preserve-output src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "memcheck": "node scripts/memcheck.ts",
    "catalog": "node scripts/catalog.ts",
    "catalog:build": "node scripts/catalog-build.ts",
    "neo": "node src/cli/neo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "catalog:docs": "node scripts/catalog-docs.ts",
    "e2e": "pnpm build && playwright test",
    "e2e:only": "playwright test",
    "budgets": "node scripts/budgets.ts",
    "drill": "node scripts/restore-drill.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@neohomepage/catalog-schema": "workspace:*",
    "chokidar": "^5.0.0",
    "hono": "^4.13.7",
    "ical.js": "2.2.1",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-grid-layout": "2.2.4",
    "undici": "^8.10.2",
    "write-file-atomic": "^8.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
