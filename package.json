{
  "name": "neohomepage-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @neohomepage/app dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "catalog:validate": "pnpm --filter @neohomepage/app catalog validate",
    "catalog:test": "pnpm --filter @neohomepage/app catalog test",
    "catalog:build": "pnpm --filter @neohomepage/app catalog:build",
    "catalog:docs": "pnpm --filter @neohomepage/app catalog:docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitepress": "^1.6.4"
  }
}
