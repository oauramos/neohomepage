{
  "manifestVersion": 1,
  "id": "navidrome-library",
  "version": "1.0.0",
  "displayName": "Navidrome · library",
  "category": "media",
  "icon": "navidrome",
  "docs": "https://oauramos.github.io/neohomepage/widgets/navidrome-library",
  "target": {
    "fields": [
      {
        "name": "username",
        "kind": "string",
        "label": "Username",
        "required": true
      },
      {
        "name": "salt",
        "kind": "string",
        "label": "Salt",
        "required": true,
        "help": "Any random string; the token is md5(password + salt)"
      },
      {
        "name": "token",
        "kind": "secret",
        "label": "Token",
        "required": true,
        "help": "md5 of your password followed by the salt, as hex"
      }
    ],
    "auth": {
      "kind": "query",
      "param": "t",
      "value": "{{secret:token}}"
    }
  },
  "config": [],
  "operations": {
    "scan": {
      "method": "GET",
      "path": "/rest/getScanStatus.view",
      "decode": "json",
      "query": {
        "u": "{{config:username}}",
        "s": "{{config:salt}}",
        "v": "1.16.1",
        "c": "neohomepage",
        "f": "json"
      }
    }
  },
  "projection": {
    "op": "pick",
    "fields": {
      "stats": {
        "op": "concat",
        "of": [
          {
            "op": "pick",
            "fields": {
              "label": {
                "op": "const",
                "value": "Songs"
              },
              "value": {
                "op": "format",
                "of": {
                  "op": "get",
                  "path": "$.subsonic-response.scanStatus.count"
                },
                "as": "number"
              }
            }
          },
          {
            "op": "pick",
            "fields": {
              "label": {
                "op": "const",
                "value": "Folders"
              },
              "value": {
                "op": "format",
                "of": {
                  "op": "get",
                  "path": "$.subsonic-response.scanStatus.folderCount"
                },
                "as": "number"
              }
            }
          },
          {
            "op": "pick",
            "fields": {
              "label": {
                "op": "const",
                "value": "Last scan"
              },
              "value": {
                "op": "format",
                "of": {
                  "op": "get",
                  "path": "$.subsonic-response.scanStatus.lastScan"
                },
                "as": "relativeTime"
              }
            }
          }
        ]
      }
    }
  },
  "presentation": {
    "template": "stat-grid"
  },
  "poll": {
    "defaultIntervalMs": 300000,
    "minIntervalMs": 60000
  },
  "requires": {
    "templates": [
      "stat-grid"
    ],
    "opcodes": [
      "concat",
      "const",
      "format",
      "get",
      "pick"
    ],
    "authKinds": [
      "query"
    ],
    "fetchKinds": [
      "json"
    ]
  }
}
